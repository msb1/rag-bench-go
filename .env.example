# Copy to .env for a fresh installation, then replace every placeholder.
# Values are intentionally non-functional and contain no private paths or endpoints.
SERVER_ADDR=MASKED_SERVER_ADDRESS
API_KEY=MASKED_API_KEY
S3_ENDPOINT_URL=MASKED_S3_ENDPOINT_URL
S3_REGION=MASKED_S3_REGION
S3_BUCKET=MASKED_S3_BUCKET
S3_PATH_MARKDOWN_PREFIX=MASKED_MARKDOWN_PREFIX
S3_ACCESS_KEY=MASKED_S3_ACCESS_KEY
S3_SECRET_KEY=MASKED_S3_SECRET_KEY

QDRANT_HOST=MASKED_QDRANT_HOST
QDRANT_GRPC_PORT=MASKED_QDRANT_GRPC_PORT
QDRANT_TLS=MASKED_QDRANT_TLS
QDRANT_API_KEY=MASKED_QDRANT_API_KEY
QDRANT_COLLECTION=MASKED_QDRANT_COLLECTION
# Separate index for the Go chunking and sparse vocabulary.
QDRANT_GO_COLLECTION=MASKED_QDRANT_GO_COLLECTION

OPENAI_LOCAL_ENDPOINT=MASKED_OPENAI_LOCAL_ENDPOINT
OPENAI_REMOTE_ENDPOINT=MASKED_OPENAI_REMOTE_ENDPOINT
OPENAI_API_KEY=MASKED_OPENAI_API_KEY
EMBEDDING_MODEL=MASKED_EMBEDDING_MODEL
EMBEDDING_ENDPOINT=MASKED_EMBEDDING_ENDPOINT
RAG_MODEL=MASKED_RAG_MODEL
RAG_ENDPOINT=MASKED_RAG_ENDPOINT
EVAL_MODEL=MASKED_EVAL_MODEL
EVAL_ENDPOINT=MASKED_EVAL_ENDPOINT
# FUSION_MODEL and FUSION_ENDPOINT default to the RAG model and endpoint.
# Optional per-role keys: EMBEDDING_API_KEY, RAG_API_KEY, EVAL_API_KEY,
# FUSION_API_KEY (otherwise OPENAI_API_KEY is used).
RERANK_ENDPOINT=MASKED_RERANK_ENDPOINT
RERANK_MODEL=MASKED_RERANK_MODEL
RERANK_API_KEY=MASKED_RERANK_API_KEY

CHUNK_TOKENS=MASKED_CHUNK_TOKENS
CHUNK_OVERLAP=MASKED_CHUNK_OVERLAP
EMBEDDING_BATCH_SIZE=MASKED_EMBEDDING_BATCH_SIZE
RETRIEVAL_K=MASKED_RETRIEVAL_K
RERANK_TOP_N=MASKED_RERANK_TOP_N
QUERY_VARIATIONS=MASKED_QUERY_VARIATIONS
HTTP_TIMEOUT=MASKED_HTTP_TIMEOUT
REQUEST_TIMEOUT=MASKED_REQUEST_TIMEOUT
MAX_DOCUMENT_BYTES=MASKED_MAX_DOCUMENT_BYTES

QUERIES_FILE=MASKED_QUERIES_FILE
ANSWERS_FILE=MASKED_ANSWERS_FILE
DATASET_FILE=MASKED_DATASET_FILE
OUTPUT_FILE=MASKED_OUTPUT_FILE
PROGRESS_FILE=MASKED_PROGRESS_FILE
HALLUCINATIONS_OUTPUT_FILE=MASKED_HALLUCINATIONS_OUTPUT_FILE
RETRIEVAL_MISSES_OUTPUT_FILE=MASKED_RETRIEVAL_MISSES_OUTPUT_FILE
DASHBOARD_FILE=MASKED_DASHBOARD_FILE
