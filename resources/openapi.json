  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Optional server API_KEY. Omit authentication when it is unset."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Question": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          }
        },
        "required": [
          "question"
        ]
      },
      "Chunk": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "page_content": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "score": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "page_content",
          "metadata"
        ]
      },
      "Record": {
        "type": "object",
        "properties": {
          "query_id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "contexts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ground_truth": {
            "type": "string"
          }
        },
        "required": [
          "question",
          "answer",
          "contexts",
          "ground_truth"
        ]
      },
      "Metrics": {
        "type": "object",
        "properties": {
          "faithfulness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "answer_relevancy": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "context_recall": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "context_precision": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "answer_correctness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "faithfulness",
          "answer_relevancy",
          "context_recall",
          "context_precision",
          "answer_correctness"
        ]
      },
      "Evaluated": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Record"
          },
          {
            "$ref": "#/components/schemas/Metrics"
          }
        ]
      },
      "RAGResult": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Record"
          },
          {
            "type": "object",
            "properties": {
              "queries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Chunk"
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "queries",
              "sources"
            ]
          }
        ]
      },
      "Limit": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Maximum new records; zero processes all. Existing completed rows are skipped."
          }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "done": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {},
          "error": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "done",
          "total",
          "created_at"
        ]
      },
      "Statistics": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          },
          "mean": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "std": {
            "type": "number"
          },
          "q1": {
            "type": "number"
          },
          "median": {
            "type": "number"
          },
          "q3": {
            "type": "number"
          }
        }
      },
      "Analysis": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "integer"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Statistics"
            }
          },
          "hallucinations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evaluated"
            }
          },
          "retrieval_misses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evaluated"
            }
          }
        }
      },
      "RerankRequest": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "top_n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 5
          }
        },
        "required": [
          "query",
          "documents"
        ]
      },
      "RerankResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "relevance_score": {
                  "type": "number"
                }
              },
              "required": [
                "index",
                "relevance_score"
              ]
            }
          }
        }
      },
      "IndexRequest": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        }
      },
      "ChunkRequest": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "markdown": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "markdown"
        ]
      },
      "AnalyzeRequest": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evaluated"
            }
          },
          "export": {
            "type": "boolean",
            "default": false,
            "description": "Write failure JSONL files and dashboard SVG to configured local output paths."
          }
        }
      }
    }
  }
}
