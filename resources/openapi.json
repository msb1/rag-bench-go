{
  "openapi": "3.0.3",
  "info": {
    "title": "rag-bench-go",
    "version": "1.0.0",
    "description": "Native Go RAG and benchmarking. Model calls may take minutes. Index, benchmark and eval return asynchronous jobs. The copied Python collection is isolated by default: QDRANT_GO_COLLECTION defaults to QDRANT_COLLECTION + _go. Set API_KEY to protect /v1 endpoints. /docs and this specification are public."
  },
